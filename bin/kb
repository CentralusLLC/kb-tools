#!/usr/bin/env sh
# kb: run kb-tools against the current repository.
# Copy this file into a project as tools/kb (it finds the repository root itself).
#
#   tools/kb inventory --by human:<name>
#   tools/kb extract --pending
#
# It uses the kb-tools Docker image when Docker has it (laptops, hosts). Without Docker
# (dev containers) it uses a local install in $KB_TOOLS_HOME, which this script creates:
#
#   tools/kb --install [--full] [ref]      # source from tools/kb.conf or KB_TOOLS_SOURCE
#
# The default (light) install has what check, work, catalog, report, log and inventory
# need. Extraction and figures run on the Paperclip machine through the kb-tools MCP
# server; --full (or KB_TOOLS_EXTRAS=extract) installs them here too.
#
# KB_TOOLS_IMAGE overrides the image (default: kb-tools:latest).
# KB_TOOLS_HOME is the local install (default: .kb-tools in the user's home from the
#   password database, which persists in agent dev containers even when $HOME is per-run;
#   $HOME when the uid has no entry there, as with `docker run -u` or in CI).
# KB_TOOLS_SOURCE is the pip source to install from. Without it, --install reads `source=`
#   from tools/kb.conf in the repository (written by `kb scaffold`), then from the last
#   install's $KB_TOOLS_HOME/install.conf, then from pip's record of an existing install
#   (installs made before tools/kb.conf existed). KB_TOOLS_REF (or `ref=` in tools/kb.conf)
#   is the default ref (main).
#
# To upgrade this file and add tools/kb.conf in a project set up by an older kb-tools:
#   tools/kb --install <ref> && tools/kb scaffold --tools-only
set -eu
IMAGE="${KB_TOOLS_IMAGE:-kb-tools:latest}"
if [ -z "${KB_TOOLS_HOME:-}" ]; then
  USER_HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)" || USER_HOME=""
  KB_TOOLS_HOME="${USER_HOME:-$HOME}/.kb-tools"
fi
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
REL="$(cd "$(pwd)" && pwd | sed "s#^$ROOT##")"

setting() { # setting KEY FILE: the value of KEY=... in FILE, if any
  [ -f "$2" ] && sed -n "s/^$1=//p" "$2" | head -n 1 | tr -d '[:space:]' || true
}

installed() { # installed WHAT: `source` (git+URL, no credentials) or `package` dir of the local install
  [ -x "$KB_TOOLS_HOME/bin/python" ] || return 0
  "$KB_TOOLS_HOME/bin/python" - "$1" 2>/dev/null <<'PY' || true
import json, sys
from importlib import metadata
try:
    dist = metadata.distribution("kb-tools")
except metadata.PackageNotFoundError:
    sys.exit(0)
if sys.argv[1] == "package":
    print(dist.locate_file("kbtools"))
    sys.exit(0)
try:
    data = json.loads(dist.read_text("direct_url.json") or "{}")
except ValueError:
    sys.exit(0)
url = data.get("url", "")
if (data.get("vcs_info") or {}).get("vcs") == "git" and url and "@" not in url.split("://", 1)[-1]:
    print("git+" + url)
PY
}

if [ "${1:-}" = "--install" ]; then
  shift
  EXTRAS="${KB_TOOLS_EXTRAS:-}"
  if [ "${1:-}" = "--full" ]; then
    EXTRAS="extract"
    shift
  fi
  REF="${1:-${KB_TOOLS_REF:-$(setting ref "$ROOT/tools/kb.conf")}}"
  REF="${REF:-main}"
  SOURCE="${KB_TOOLS_SOURCE:-$(setting source "$ROOT/tools/kb.conf")}"
  SOURCE="${SOURCE:-$(setting source "$KB_TOOLS_HOME/install.conf")}"
  SOURCE="${SOURCE:-$(installed source)}"
  case "$SOURCE" in
    ""|*"<"*)
      echo "kb: no kb-tools source. Set source= in tools/kb.conf (kb scaffold writes it) or run" >&2
      echo "    KB_TOOLS_SOURCE=git+https://github.com/<owner>/kb-tools tools/kb --install $REF" >&2
      exit 2 ;;
  esac
  case "$EXTRAS" in
    "") SPEC="$SOURCE@$REF"; KIND="light" ;;
    *) SPEC="kb-tools[$EXTRAS] @ $SOURCE@$REF"; KIND="full ($EXTRAS)" ;;
  esac
  echo "kb: installing $SOURCE@$REF, $KIND, into $KB_TOOLS_HOME" >&2
  python3 -m venv --clear "$KB_TOOLS_HOME"
  "$KB_TOOLS_HOME/bin/pip" install --quiet --disable-pip-version-check "$SPEC"
  printf 'source=%s\nref=%s\nextras=%s\n' "$SOURCE" "$REF" "$EXTRAS" > "$KB_TOOLS_HOME/install.conf"
  PACKAGE="$(installed package)"
  if [ -n "$PACKAGE" ] && [ -f "$PACKAGE/template/tools/kb" ] && [ -f "$ROOT/tools/kb" ] &&
     ! cmp -s "$PACKAGE/template/tools/kb" "$ROOT/tools/kb"; then
    echo "kb: this project's tools/kb differs from the installed version's. To update it (and add" >&2
    echo "    tools/kb.conf if missing), run: tools/kb scaffold --tools-only" >&2
  fi
  exec "$KB_TOOLS_HOME/bin/kb" --version
fi

if command -v docker >/dev/null 2>&1 && docker image inspect "$IMAGE" >/dev/null 2>&1; then
  TTY=""
  [ -t 1 ] && TTY="-t"
  exec docker run --rm -i $TTY \
    -u "$(id -u):$(id -g)" \
    -v "$ROOT:/work" -w "/work$REL" \
    --network none \
    "$IMAGE" "$@"
fi

if [ -x "$KB_TOOLS_HOME/bin/kb" ]; then
  exec "$KB_TOOLS_HOME/bin/kb" "$@"
fi

echo "kb: no kb-tools found. Either build the Docker image $IMAGE from the kb-tools repository:" >&2
echo "    git clone <kb-tools repo> && docker build -t kb-tools:latest kb-tools" >&2
echo "or, without Docker (dev containers), install it locally into $KB_TOOLS_HOME:" >&2
echo "    tools/kb --install main" >&2
exit 1
