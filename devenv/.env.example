# Copy to .env (git-ignored) and fill in. Non-secret deployment values only belong here;
# keep a copy of the token in your secret store (for Paperclip: a company secret).
#
# Bearer token Paperclip sends to the manager (at least 24 characters). Secret.
DEVENV_TOKEN=
# Address on this host that the Paperclip server can reach; the manager and every dev
# container's sshd are published on it. Keep it private (not a public interface).
DEVENV_HOST_IP=<host-ip>
# Host port for the manager's MCP endpoint: http://<host-ip>:<manager-port>/mcp
DEVENV_MANAGER_PORT=8780
# Host port range for dev containers' sshd, one port per project.
DEVENV_PORTS=24000-24099
# Per-container limits.
DEVENV_MEMORY=8g
DEVENV_CPUS=6
DEVENV_PIDS=4096
# Seconds a rebuild waits for running agent sessions before giving up.
DEVENV_SWAP_WAIT=21600
